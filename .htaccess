# Apache hosting (e.g. Swiss shared hosting)
# Security headers — keep the three hosting configs (_headers, vercel.json, .htaccess) in sync.
# Content-Security-Policy: if you add a service (form endpoint, analytics, new image host), add its domain to the
# matching directive (e.g. a form endpoint goes into connect-src), otherwise the browser blocks it.
# X-Robots-Tag keeps the site out of search engines; remove that line (and the robots meta tags in index.html) at launch.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://images.unsplash.com https://listing-images.autoscout24.ch; connect-src 'self'; frame-src https://maps.google.com https://www.google.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # HSTS only when the request came over HTTPS
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# Block hidden files and folders (.git, .htaccess, .env, …) — except /.well-known (certificates)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(^|/).(?!well-known/)" - [F]
  # Force HTTPS: enable these two lines once an SSL certificate is installed
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Private PHP settings (e-mail address) must never be served directly
<FilesMatch "^config(\.example)?\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

# Directory listing: most hosts disable it already. If yours does not, uncomment (some hosts don't allow it here):
# Options -Indexes
